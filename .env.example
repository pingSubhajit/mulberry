GOOGLE_SERVER_CLIENT_ID=
GOOGLE_ALLOWED_CLIENT_IDS=
ALLOW_DEV_GOOGLE_TOKENS=false
DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=
POSTHOG_ENVIRONMENT=development
POSTHOG_DISABLED=false
CANVAS_UPDATE_PUSH_TTL_MS=86400000
PAIRING_CONFIRMATION_PUSH_TTL_MS=60000
PROD_API_BASE_URL=https://api.mulberry.my/
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WALLPAPER_BUCKET=
SUPABASE_STICKER_BUCKET=
ADMIN_PASSWORD=
# iCloud links to the iOS wallpaper Shortcut, one per app bundle ID: bundle.id=https://www.icloud.com/shortcuts/…, comma separated.
WALLPAPER_SHORTCUT_LINKS=
# Development only: keep sticker assets on the local backend instead of Supabase.
# docker-compose mounts a volume at /data/sticker-assets for this.
STICKER_LOCAL_STORAGE_DIR=
# Development only: the same for wallpaper catalog assets. docker-compose mounts /data/wallpaper-assets.
WALLPAPER_LOCAL_STORAGE_DIR=

# APNs auth keys for widget reloads, which Firebase cannot carry. The .p8 contents on one line,
# with line breaks written as \n. Sandbox reaches development builds; production, release builds.
APNS_TEAM_ID=
APNS_SANDBOX_KEY_ID=
APNS_SANDBOX_PRIVATE_KEY=
APNS_PRODUCTION_KEY_ID=
APNS_PRODUCTION_PRIVATE_KEY=
