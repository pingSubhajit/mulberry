// The production environment. Debug/Release controls compilation, not identity.
MULBERRY_APP_ENVIRONMENT = prod
MULBERRY_BUNDLE_IDENTIFIER = com.subhajit.mulberry.beta
MULBERRY_APP_ICON = AppIcon
MULBERRY_ALLOW_LOCAL_SERVER = NO
MULBERRY_API_BASE_URL = https:/$()/api.mulberry.my/
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID =
GOOGLE_SERVER_CLIENT_ID =

MULBERRY_ENTITLEMENTS_FILE = Configuration/Mulberry.entitlements
// Debug and Release builds of both apps sign with the paid team.
DEVELOPMENT_TEAM = HMJX9736KN
// Where the app leaves the anniversary for the widget extension; one per app identity.
MULBERRY_APP_GROUP = group.$(MULBERRY_BUNDLE_IDENTIFIER)
APS_ENVIRONMENT = production
#include? "Production.local.xcconfig"
